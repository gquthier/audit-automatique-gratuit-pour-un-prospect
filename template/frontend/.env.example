# Backend (côté serveur uniquement, jamais exposé au navigateur)
API_URL=https://api.exemple.fr
ADMIN_API_KEY=

# Admin
ADMIN_PASSWORD=
# Facultatif : par défaut, la signature du cookie est dérivée d'ADMIN_API_KEY.
ADMIN_SESSION_SECRET=

# Facultatif : origine autorisée à afficher la page en aperçu dans un cadre (votre CRM)
FRAME_ANCESTORS=

# Démonstration locale uniquement, jamais en production
USE_FIXTURES=
