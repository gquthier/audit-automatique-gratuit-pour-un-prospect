# Base et volume
DATABASE_URL=postgres://user:password@host:5432/audit
DATA_DIR=/data
PORT=8080

# Adresses publiques
PUBLIC_BASE_URL=https://api.exemple.fr
FRONTEND_ORIGIN=https://audit.exemple.fr
BOOKING_URL=https://exemple.fr/rendez-vous

# Accès (obligatoires en production)
ADMIN_API_KEY=une-cle-longue-et-aleatoire
OPENROUTER_API_KEY=
APIFY_TOKEN=
KIE_API_KEY=

# Réservations : generic (webhook /webhooks/booking) ou iclosed (sonde de l'API)
BOOKING_PROVIDER=generic
BOOKING_WEBHOOK_SECRET=un-secret-long-et-aleatoire
# Facultatif : limite aux événements listés, séparés par des virgules
BOOKING_EVENT_IDS=
ICLOSED_API_KEY=

# Modèles (OpenRouter) : vérifiez le dernier Flash disponible
LLM_MODEL=google/gemini-3.8-flash
LLM_FALLBACK=moonshotai/kimi-k3

# Garde-fous
MAX_AUDITS_PER_DAY=25
MAX_GENERATIONS_PER_AUDIT=14
KIE_CREDIT_RESERVE=150
REUSE_WINDOW_DAYS=30
ADS_RESULTS_LIMIT=30
ADS_MAX_QUERIES=6
ADS_MIN_COMPETITORS=3
ADS_MAX_COMPETITORS=8
CHAT_MAX_MESSAGES_PER_SESSION=40
CHAT_MAX_PER_AUDIT_PER_DAY=400
CHAT_RATE_PER_MINUTE=15

# Interrupteurs (true par défaut)
POLLER_ENABLED=true
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# Option : coût estimé par créative. Laisser vide pour ne rien afficher.
# Ces deux valeurs doivent venir des données réelles de VOS campagnes.
COST_ESTIMATE_MIN=
COST_ESTIMATE_MAX=
